package_name("com.jjrapps.aquihaytomate")

# The Play service-account key authenticates as the developer account shared by the com.jjrapps apps,
# so it never lives inside the repo. Two sources, in this order:
#
# 1. ANDROID_AQUIHAYTOMATE_JSON_KEY — the JSON content itself, if it is ever added to Bitwarden
#    Secrets Manager and injected with `con-claves 'fastlane subir'`. Nothing is written to disk.
# 2. The file ~/.config/play/jjrmobileapps.json, the account-wide key also used by Constanza.
#
# Do not define SUPPLY_JSON_KEY: supply reads that variable on its own, and when it is present it
# silently wins over both sources above.
play_key_json = ENV["ANDROID_AQUIHAYTOMATE_JSON_KEY"].to_s
if play_key_json.strip.empty?
  json_key_file(File.expand_path("~/.config/play/jjrmobileapps.json"))
else
  json_key_data_raw(play_key_json)
end
