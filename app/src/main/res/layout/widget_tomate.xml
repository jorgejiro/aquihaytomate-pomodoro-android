<?xml version="1.0" encoding="utf-8"?>
<!--
  The 1×1 widget. XML rather than Compose on purpose — see
  docs/decisions/001-widget-con-remoteviews-y-chronometer.md: RemoteViews is the only way to get at the
  Chronometer, which ticks inside the launcher's process without ever waking ours.

  The whole plate is one tap target. The Chronometer and the figure are stacked over the rasterised
  tomato, which comes in as a bitmap from TomatoBitmapRenderer — and so is the play/pause glyph, drawn
  there rather than typed here: Space Grotesk has no ▸ or ❚ and the fallback rendered a dark speck.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_plate"
    android:padding="2dp">

    <ImageView
        android:id="@+id/widget_tomato"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:contentDescription="@string/widget_label"
        android:scaleType="fitCenter" />

    <!--
      Two mutually exclusive readouts. The Chronometer counts down by itself while the timer runs; the
      TextView shows a frozen figure or a glyph in every other state, because a Chronometer cannot be
      told to stand still at an arbitrary value.
    -->
    <Chronometer
        android:id="@+id/widget_chronometer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/space_grotesk_variable"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#FFF5F2EF"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_static_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/space_grotesk_variable"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#FFF5F2EF"
        android:textSize="13sp" />

</FrameLayout>
