<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget plate: black, with the corner radius the system hands out so the widget matches whatever the
  launcher does with the rest of the home screen.

  **No stroke.** It used to carry a 1 dp hairline at 14 % white, on the theory that a black plate would
  otherwise vanish into a dark wallpaper. It does vanish — and that is fine, because what has to be seen is
  the tomato, and the tomato is always there. What the hairline actually did was ring the widget with a grey
  outline that reads as dirt on the home screen and goes against the «no cards, no boxes» of §1 of
  CLAUDE.md. Over a light wallpaper the black plate already cuts its own silhouette.
  See docs/design-spec.md §7.1.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
    <solid android:color="#FF000000" />
</shape>
