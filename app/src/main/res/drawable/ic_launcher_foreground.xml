<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: the clock face, the two hands, the calyx and the highlight. The body of the
  tomato is the background layer, which fills the whole canvas so that the launcher's mask is what
  shapes the fruit — see ic_launcher_background.xml.

  Since 1.3 the fruit is also a dial. The 1.2 icon was a red circle with leaves on top and said nothing
  about what the app does: the shape of the tomato was drawn by the launcher's crop, not by us, so there
  was no outline either. Drawing the dial *inside* solves both at once — it reads as an object with an
  edge without needing a plate, and it reads as a timer. See docs/decisions/014-*.

  The two hands are not decoration. The short thick one points at five o'clock, which on the minute
  scale is the 25 of a focus block; the long thin one points at one o'clock, which is the 5 of a short
  break. The icon spells out both of the app's defaults in the only notation a clock can read.

  Everything stays inside the 66 dp safe zone (21..87 on both axes): the tick marks stop at radius 31.5
  and the stem starts at y=23, so no launcher mask can clip them.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Specular highlight, top left. Sits under the dial: it belongs to the body of the fruit. -->
    <path
        android:pathData="M30,41 C34.5,35 42,32 48,33.5 C42,36.5 36,41 33,48.5 C30.75,47.75 29.25,45 30,41 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.20" />

    <!--
      Quarter marks: thicker and longer, so 3/6/9 stay readable at 48 px.

      There is no mark at twelve. It would fall exactly under the stem, which is 3 dp wide and starts at
      y=23, so it would be invisible ink. **The stem is the twelve** — the tomato's own sprig indexes
      the top of the dial.
    -->
    <path
        android:pathData="M85.5,54 L80.7,54 M54,85.5 L54,80.7 M22.5,54 L27.3,54"
        android:strokeColor="#F5F2EF"
        android:strokeWidth="2.2" />

    <!-- The other eight five-minute marks. -->
    <path
        android:pathData="M69.75,26.72 L68.25,29.32 M81.28,38.25 L78.68,39.75 M81.28,69.75 L78.68,68.25 M69.75,81.28 L68.25,78.68 M38.25,81.28 L39.75,78.68 M26.72,69.75 L29.32,68.25 M26.72,38.25 L29.32,39.75 M38.25,26.72 L39.75,29.32"
        android:strokeColor="#F5F2EF"
        android:strokeWidth="1.5" />

    <!--
      The two hands are capsules: constant width, round caps. They were first drawn as polygons that
      tapered towards the tip, and that made both of them *start* wide at the axis — with the pin on top,
      the centre came out as a lump. Constant width keeps the middle clean and the pin can stay.

      The contrast between them has to be strong: at 5:05 they sit 120° apart, and with similar weights
      the two arms form a symmetric vee that reads as an arrow instead of a clock. Lengths follow the
      classic ratio, the hour hand at about 0.72 of the minute hand.
    -->

    <!-- Minute hand → one o'clock → the 5 min of a short break. Long and thin. -->
    <path
        android:pathData="M54,54 L66.75,31.92"
        android:strokeColor="#F5F2EF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />

    <!-- Hour hand → five o'clock → the 25 min of a focus block. Shorter and thicker. -->
    <path
        android:pathData="M54,54 L63.25,70.02"
        android:strokeColor="#F5F2EF"
        android:strokeWidth="4.2"
        android:strokeLineCap="round" />

    <!-- Centre pin, r=3.6: a plain round, which is what a clock has where the hands meet. -->
    <path
        android:pathData="M54,50.4 C55.99,50.4 57.6,52.01 57.6,54 C57.6,55.99 55.99,57.6 54,57.6 C52.01,57.6 50.4,55.99 50.4,54 C50.4,52.01 52.01,50.4 54,50.4 Z"
        android:fillColor="#F5F2EF" />

    <!--
      A soft shadow under the calyx, offset 1.2 dp. Green on red is a complementary pair of similar
      lightness, so without it the leaves sit flat on the body instead of on top of it.
    -->
    <path
        android:pathData="M52.5,24.2 L55.5,24.2 L55.5,29.6 L52.5,29.6 Z"
        android:fillColor="#000000"
        android:fillAlpha="0.18" />
    <path
        android:pathData="M54,27.6 L60.21,23.88 L65.5,27.6 L59.41,33.6 L54,34.44 L48.59,33.6 L42.5,27.6 L47.79,23.88 Z"
        android:fillColor="#000000"
        android:fillAlpha="0.18" />

    <!-- Stem -->
    <path
        android:pathData="M52.5,23 L55.5,23 L55.5,28.4 L52.5,28.4 Z"
        android:fillColor="#37622A" />

    <!--
      Calyx, three leaves. Smaller than in 1.2: with the dial underneath, the old size covered the 11
      and 1 o'clock marks and the fruit read as a tomato wearing a hat.
    -->
    <path
        android:pathData="M54,26.4 L60.21,22.68 L65.5,26.4 L59.41,32.4 L54,33.24 L48.59,32.4 L42.5,26.4 L47.79,22.68 Z"
        android:fillColor="#57943E" />
</vector>
