<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: the stem and the specular highlight only. The body of the tomato is the
  background layer, which fills the whole canvas so that the launcher's mask is what shapes the fruit —
  see ic_launcher_background.xml.

  Everything stays inside the 66 dp safe zone (21..87 on both axes), so no launcher mask can clip it.
  The stem sits high in that zone, near the top of the circle, which is where a tomato's calyx is.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Specular highlight, top left. Scaled with the fruit: the body is now the whole icon. -->
    <path
        android:pathData="M36,45 C40.5,39 48,36 54,37.5 C48,40.5 42,45 39,52.5 C36.75,51.75 35.25,49 36,45 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.20" />

    <!--
      A soft shadow under the calyx, offset 1.2 dp. Green on red is a complementary pair of similar
      lightness, so without it the leaves sit flat on the body instead of on top of it.
    -->
    <path
        android:pathData="M54,32.6 L64.4,28.7 L73.5,32.6 L63.1,41.7 L54,43 L44.9,41.7 L34.5,32.6 L43.6,28.7 Z"
        android:fillColor="#000000"
        android:fillAlpha="0.18" />

    <!-- Stem -->
    <path
        android:pathData="M52.3,24 L55.7,24 L55.7,36 L52.3,36 Z"
        android:fillColor="#37622A" />

    <!-- Calyx, three leaves -->
    <path
        android:pathData="M54,31.4 L64.4,27.5 L73.5,31.4 L63.1,40.5 L54,41.8 L44.9,40.5 L34.5,31.4 L43.6,27.5 Z"
        android:fillColor="#57943E" />
</vector>
